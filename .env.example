CHAIN_ENDPOINT=wss://archive.matrix.blockchain.enjin.io
CHAIN_PREFIX=1110
ARCHIVE_ENDPOINT=https://v2.archive.subsquid.io/network/enjin-matrix
TRUNCATE_DATABASE=false
SKIP_SYNC=false

DB_NAME=postgres
DB_USER=postgres
DB_PASS=postgres
DB_HOST=indexer_db
DB_PORT=5432
REDIS_URL=redis://indexer_redis:6379

DOCKER_DB_HOST=host.docker.internal

# Hasura
HASURA_VERSION=v2.49.5
HASURA_GRAPHQL_ENDPOINT=http://localhost:8085
HASURA_GRAPHQL_ADMIN_SECRET=change-me-hasura-admin-secret
HASURA_GRAPHQL_ENABLE_CONSOLE=true
HASURA_GRAPHQL_DEV_MODE=true
HASURA_GRAPHQL_STRINGIFY_NUMERIC_TYPES=true
HASURA_EXTENSION_GRAPHQL_URL=http://indexer_extensions:4001/graphql
HASURA_EXTENSION_SECRET=change-me-extension-secret

# OPTIONAL
APP_ENV=
PROMETHEUS_PORT=7364
PROCESSOR_PROMETHEUS_ENDPOINT=http://localhost:7364
SQD_DEBUG=
GQL_PORT=4000
EXTENSION_GRAPHQL_PORT=4001
EXTENSION_DB_CONNECTION_POOL_SIZE=5
EXTENSION_GRAPHQL_MAX_ROOT_FIELDS=100
ENJIN_METADATA_LANGUAGE=
ENJIN_METADATA_TIMEOUT_MS=5000
ENJIN_METADATA_MAX_BATCH_SIZE=100
ENJIN_METADATA_MAX_RESPONSE_BYTES=5242880
PINATA_GATEWAY_TOKEN=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

AWS_SNS_TOPIC_ARN=
AWS_DEFAULT_REGION=
AWS_ACCESS_KEY=
AWS_SECRET_KEY=

MARKETPLACE_API_STG_URL=
MARKETPLACE_API_PROD_URL=

LOGTAIL_TOKEN=
LOGTAIL_HOST=
